#!/bin/bash
# Ersetzt das Original aus linuxserver/brave: OHNE --no-sandbox.
# Die eigene Erweiterung kommt per Richtlinie (ExtensionInstallForcelist).

BIN=/usr/bin/brave-browser

# Fail-closed: ohne aktive Firewall kein Browser
if [ ! -f /run/sb-firewall-ok ]; then
  echo "[Glasbox] Firewall nicht aktiv – Brave startet nicht" >&2
  exit 1
fi

# Fenster-Wächter: hält Brave maximiert (läuft weiter, wenn Brave neu startet)
pgrep -f glasbox-fenster > /dev/null || setsid /usr/bin/python3 -I /usr/local/bin/glasbox-fenster < /dev/null > /dev/null 2>&1 &

if pgrep brave > /dev/null; then
  rm -f "$HOME"/.config/BraveSoftware/Brave-Browser/Singleton*
fi

if [ "${PIXELFLUX_WAYLAND,,}" == "true" ]; then
  WAYLAND="--ozone-platform=wayland"
fi

exec ${BIN} \
  --no-first-run \
  --enable-smooth-scrolling \
  --password-store=basic \
  --simulate-outdated-no-au='Tue, 31 Dec 2099 23:59:59 GMT' \
  --start-maximized \
  ${WAYLAND} \
  "$@" > /dev/null 2>&1
